# ==============================================================================
# NNACO SA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env` di root direktori project
# dan isi dengan token / API key yang valid.

# Fonnte WhatsApp OTP & Notification Gateway
FONNTE_TOKEN=your_fonnte_token_here
FONNTE_API_URL=https://api.fonnte.com/send

# AI Service Provider: 'groq', 'gemini', atau 'mock'
AI_PROVIDER=groq

# Groq AI Cloud API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
